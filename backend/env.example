# ---- Base de datos (Supabase / Postgres) ----
DB_URL=
DB_USER=
DB_PASSWORD=
DB_SCHEMA=public
DB_POOL_SIZE=5
FLYWAY_ENABLED=true
DB_STATUS_DETAILS=true
DB_PORT=5432


PORT=8080
# Lista separada por comas. Nunca "*": se envian credenciales.
CORS_ALLOWED_ORIGINS=
JWT_SECRET=

# ---- OpenAPI ----
OPENAPI_STAGING_URL=
